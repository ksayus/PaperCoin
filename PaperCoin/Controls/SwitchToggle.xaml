<UserControl x:Class="PaperCoin.Controls.SwitchToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="42" Height="22"
             Cursor="Hand"
             Focusable="True"
             Background="Transparent"
             MouseLeftButtonUp="Root_MouseLeftButtonUp"
             KeyDown="Root_KeyDown">

    <!-- 滑轨两层叠加：切换时只动画上层的 Opacity。上下层颜色来自 DynamicResource，
         对 Background.Color 做 ColorAnimation 会让动画值压过资源，主题切换后这个控件颜色不再更新。 -->
    <Grid>
        <Border CornerRadius="11"
                Background="{DynamicResource ColorCardActionBackground}"/>

        <Border x:Name="OnLayer" CornerRadius="11" Opacity="0"
                Background="{DynamicResource ColorAddNewBillBtn}"/>

        <!-- 滑块。位移走 TranslateTransform，宽度变化走 ScaleTransform：
             切换瞬间滑块会先横向压扁再回弹，读起来是"被拨过去"的。 -->
        <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="3,0,0,0"
                RenderTransformOrigin="0.5,0.5"
                Background="{DynamicResource ColorTextSecondary}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="KnobStretch" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="KnobShift" X="0"/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>

        <!-- 焦点提示：键盘 Tab 到达时才显示 -->
        <Border x:Name="FocusRing" CornerRadius="11"
                BorderThickness="1" Opacity="0"
                BorderBrush="{DynamicResource ColorAddNewBillBtn}"/>
    </Grid>
</UserControl>
