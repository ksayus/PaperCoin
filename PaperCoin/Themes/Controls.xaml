<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 日历：期间导航按钮。用几何字符 ‹ ›，当前字体没有箭头字形。 -->
    <Style x:Key="PeriodNavBtn" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ColorCardActionBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 胶囊按钮（日历的“今天”）。必须有模板：Button 默认主题模板不理会 CornerRadius，只设 Background/BorderThickness 拿不到圆角。 -->
    <Style x:Key="PillButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ColorCardActionBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" CornerRadius="11"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 日历 / 设置：分段选择（日・月・年、主题三选一）。用 RadioButton + GroupName 保证互斥，ViewModel 不必维护取消其它项的逻辑。 -->
    <Style x:Key="ModeRadio" TargetType="{x:Type RadioButton}">
        <Setter Property="GroupName" Value="ModeGroup"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                            Background="{DynamicResource ColorCardBackground}"
                            BorderBrush="{DynamicResource ColorCardBorder}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ColorAddNewBillBtn}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置页：行容器 / 分组标题 / 行图标 -->
    <Style x:Key="SettingRow" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource ColorCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SettingGroupTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
    </Style>

    <!-- 行图标。不设 Text 的 Setter，各图标自己指定码位，码位集中定义在 Icon/AppIcons.xaml。 -->
    <Style x:Key="SettingRowIcon" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Iconfont}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
    </Style>

    <!-- 设置页的小按钮 -->
    <Style x:Key="SettingButton" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource ColorCardActionBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 记账面板：日期选择。必须整只换模板：DatePicker 默认模板把内层 DatePickerTextBox 的底色写死成白色，
         与本项目接近白的前景色撞成白底白字。模板部件是控件契约，一个都不能少：
         PART_TextBox（日期文本）、PART_Button / PART_Popup（弹出日历）、PART_Calendar（弹出层里的日历本体）。 -->

    <Style x:Key="DateFieldButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{DynamicResource Iconfont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Content" Value="{DynamicResource IconCalendar}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" CornerRadius="0,5,5,0"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ColorCardActionBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DateFieldTextBox" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource ColorAddNewBillBtn}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid>
                        <!-- PART_ContentHost 是 TextBoxBase 的契约部件,
                             少了它一个字都显示不出来 -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>

                        <!-- 空值提示。写死文案而不是绑定 Watermark:
                             DatePickerTextBox 上没有这个属性(编译器会直接报
                             MC4005), 默认模板的占位文字是自己那一套。
                             日期被清空时这里补一句, 否则就是一个空白框。 -->
                        <TextBlock x:Name="PART_Watermark"
                                   Text="选择日期"
                                   Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DatePickerThemed" TargetType="{x:Type DatePicker}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="Background" Value="{DynamicResource ColorCardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ColorCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Grid x:Name="PART_Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 外框: 与面板里其它输入框同一副长相 -->
                        <Border x:Name="FieldBorder" Grid.ColumnSpan="2" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>

                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                           Style="{DynamicResource DateFieldTextBox}"
                                           Foreground="{TemplateBinding Foreground}"/>

                        <Button x:Name="PART_Button" Grid.Column="1"
                                Style="{DynamicResource DateFieldButton}"/>

                        <!-- 弹出层保持系统日历的样子, 不硬改成深色:
                             里面的 CalendarDayButton 前景色来自系统主题,
                             只把底色改深会变成深底深字, 反而更看不清。
                             要统一得连 Calendar 的三个模板一起换。 -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_Root}"
                               StaysOpen="False">
                            <Border Margin="0,4,0,0" CornerRadius="4" Padding="2"
                                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}"
                                    BorderThickness="1">
                                <Calendar x:Name="PART_Calendar"
                                          Style="{TemplateBinding CalendarStyle}"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush"
                                    Value="{DynamicResource ColorAddNewBillBtn}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FieldBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 设置页下拉框。必须整只换模板：ComboBox 的默认模板不认 CornerRadius，
         也不跟随主题画刷，会出现深色卡片旁边一块灰色系统控件。 -->
    <Style x:Key="ComboToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                            Background="{DynamicResource ColorCardActionBackground}"
                            BorderBrush="{DynamicResource ColorCardBorder}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="⌄" FontSize="12"
                                       Margin="8,-4,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ColorCardActionBackground}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ColorSideBarBtnActive}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxThemed" TargetType="{x:Type ComboBox}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource ColorTextTitle}"/>
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <!-- IsDropDownOpen 必须双向绑到 ToggleButton.IsChecked 并按
                             ClickMode=Press 工作, 否则点一下只展开、再点收不起来。 -->
                        <ToggleButton Style="{DynamicResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}">
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               Focusable="False">
                            <Border Margin="0,4,0,0" CornerRadius="6" Padding="4"
                                    MinWidth="{Binding ActualWidth,
                                               RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="200"
                                    Background="{DynamicResource ColorMainContentArea}"
                                    BorderBrush="{DynamicResource ColorCardBorder}"
                                    BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 滚动条：全应用统一的装饰外观。

         隐式样式（无 x:Key），对本程序里所有 ScrollBar 生效，包括下拉框弹出的那一层。
         必须整只换模板的理由同 ComboBox：系统默认滚动条不认主题画刷，
         会在深色卡片边上露出一条浅灰的经典控件外观。
         颜色沿用既有主题画刷，不新增色值，否则 Dark.xaml 与 Bright.xaml 必须同步加 key。 -->

    <!-- 滑块: 圆角药丸。Margin 让它在轨道里两侧各留 1px, 视觉上细于轨道 -->
    <Style x:Key="ThemedScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbPill" Margin="1" CornerRadius="3"
                            Background="{DynamicResource ColorCardBorder}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbPill" Property="Background"
                                    Value="{DynamicResource ColorTextSecondary}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbPill" Property="Background"
                                    Value="{DynamicResource ColorTextSecondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 翻页热区: 完全透明但仍然可命中(Background=Transparent 参与命中测试,
         写成 null 就点不到了), 因此点击轨道空白处照常翻页。 -->
    <Style x:Key="ThemedScrollPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ThemedVerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThemedScrollPageButton}"
                                  Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <!-- MinHeight: 内容很长时按比例算出的滑块会短到抓不住 -->
                    <Thumb Style="{StaticResource ThemedScrollThumb}"
                           Width="9" MinHeight="24"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThemedScrollPageButton}"
                                  Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="ThemedHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThemedScrollPageButton}"
                                  Command="{x:Static ScrollBar.PageLeftCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ThemedScrollThumb}"
                           Height="9" MinWidth="24"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ThemedScrollPageButton}"
                                  Command="{x:Static ScrollBar.PageRightCommand}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- 隐式样式：不写 x:Key，覆盖全应用的所有 ScrollBar。
         OverridesDefaultStyle 必须开，否则系统主题样式里没显式赋值的属性（背景、按钮宽度）
         仍会渗进来，叠出一只“半装饰”的滚动条。 -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="MinWidth" Value="9"/>
        <Setter Property="Template" Value="{StaticResource ThemedVerticalScrollBar}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="9"/>
                <Setter Property="MinHeight" Value="9"/>
                <Setter Property="Template" Value="{StaticResource ThemedHorizontalScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
