<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 标题栏 -->
    <!-- Windows 风格（暗色）：Fluent 观感。表面纯色不透明，层级靠中性灰阶拉开而不是靠阴影，
         强调色用系统蓝 #0078D4，正文与次要文字的明度差比经典暗色拉得更开。 -->
    <!-- 玻璃背板：这几套风格表面不透明，背板用 Transparent 等于不存在。
         键必须存在 —— 主题切换按 key 就地替换条目，少一个键 DynamicResource 会静默回退。 -->
    <SolidColorBrush x:Key="ColorGlassBackdrop" Color="Transparent"/>
    <SolidColorBrush x:Key="ColorGlassScrim" Color="Transparent"/>

    <SolidColorBrush x:Key="ColorTitleTop" Color="#202020"/>
    <SolidColorBrush x:Key="ColorSideBar" Color="#272727"/>
    <SolidColorBrush x:Key="ColorMainContentArea" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="ColorCardBackground" Color="#323232"/>
    <SolidColorBrush x:Key="ColorCardBorder" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ColorCardActionBackground" Color="#3A3A3A"/>
    <!-- 按钮 -->
    <SolidColorBrush x:Key="ColorSideBarBtn" Color="Transparent"/>
    <SolidColorBrush x:Key="ColorSideBarBtnOver" Color="#333333"/>
    <SolidColorBrush x:Key="ColorSideBarBtnActive" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ColorSideBarBtnPressed" Color="#2A2A2A"/>
    <!-- 主按钮（右下角 ＋） -->
    <SolidColorBrush x:Key="ColorAddNewBillBtn" Color="#0078D4"/>
    <SolidColorBrush x:Key="ColorAddNewBillBtnOver" Color="#1A86D9"/>
    <SolidColorBrush x:Key="ColorAddNewBillBtnPressed" Color="#006CBE"/>
    <!-- 文字 -->
    <SolidColorBrush x:Key="ColorTextTitle" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#C5C5C5"/>
    <!-- 金额：正数为收入，负数为支出 -->
    <SolidColorBrush x:Key="ColorPositive" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="ColorNegative" Color="#FF99A4"/>
    <!-- 阴影 -->
    <SolidColorBrush x:Key="ColorShadow" Color="#000000" Opacity="0.55"/>
    <SolidColorBrush x:Key="ColorWindowShadow" Color="#000000" Opacity="0.50"/>
    <!-- 分类色板：槽位由 Core/CategoryPalette 按分类名求稳定哈希决定，键名不可改 -->
    <SolidColorBrush x:Key="CategoryColor01" Color="#4CC2FF"/>
    <SolidColorBrush x:Key="CategoryColor02" Color="#B79CFF"/>
    <SolidColorBrush x:Key="CategoryColor03" Color="#FF8FA8"/>
    <SolidColorBrush x:Key="CategoryColor04" Color="#3FD0C9"/>
    <SolidColorBrush x:Key="CategoryColor05" Color="#FFC46B"/>
    <SolidColorBrush x:Key="CategoryColor06" Color="#C3DE6A"/>
    <SolidColorBrush x:Key="CategoryColor07" Color="#9DA8FF"/>
    <SolidColorBrush x:Key="CategoryColor08" Color="#5FD3F0"/>
    <SolidColorBrush x:Key="CategoryColor09" Color="#FF9F6B"/>
    <SolidColorBrush x:Key="CategoryColor10" Color="#78DEA8"/>
    <SolidColorBrush x:Key="CategoryColorOther" Color="#9B9B9B"/>

</ResourceDictionary>
