<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Title -->
    <!-- 玻璃背板：这几套风格表面不透明，背板用 Transparent 等于不存在。
         键必须存在 —— 主题切换按 key 就地替换条目，少一个键 DynamicResource 会静默回退。 -->
    <SolidColorBrush x:Key="ColorGlassBackdrop" Color="Transparent"/>
    <SolidColorBrush x:Key="ColorGlassScrim" Color="Transparent"/>

    <SolidColorBrush x:Key="ColorTitleTop" Color="#131e2a"/>
    
    <!-- Card -->
    <SolidColorBrush x:Key="ColorSideBar" Color="#161F2C"/>
    <SolidColorBrush x:Key="ColorMainContentArea" Color="#1B2533"/>
    <SolidColorBrush x:Key="ColorCardBackground" Color="#1F2A3A"/>
    <SolidColorBrush x:Key="ColorCardBorder" Color="#2E3D52"/>
    <SolidColorBrush x:Key="ColorCardActionBackground" Color="#2B3A4D"/>

    <!-- Button -->
    <SolidColorBrush x:Key="ColorSideBarBtn" Color="Transparent"/>
    <SolidColorBrush x:Key="ColorSideBarBtnOver" Color="#243244"/>
    <SolidColorBrush x:Key="ColorSideBarBtnActive" Color="#2B3A4D"/>
    <SolidColorBrush x:Key="ColorSideBarBtnPressed" Color="#1C2735"/>

    <SolidColorBrush x:Key="ColorAddNewBillBtn" Color="#33465E"/>
    <SolidColorBrush x:Key="ColorAddNewBillBtnOver" Color="#3E5470"/>
    <SolidColorBrush x:Key="ColorAddNewBillBtnPressed" Color="#2A3B50"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ColorTextTitle" Color="#f0f4fa"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#93A4BA"/>

    <!-- Amount：收入为正，支出为负 -->
    <SolidColorBrush x:Key="ColorPositive" Color="#4FD08A"/>
    <SolidColorBrush x:Key="ColorNegative" Color="#F0736A"/>

    <!-- Shadow：暗色主题下阴影更浓，否则在深底上看不出层次 -->
    <SolidColorBrush x:Key="ColorShadow" Color="#000000" Opacity="0.65"/>
    <SolidColorBrush x:Key="ColorWindowShadow" Color="#000000" Opacity="0.55"/>

    <!-- 分类色板：槽位由 Core/CategoryPalette 按分类名求稳定哈希决定，键名不可改。
         色相在色轮上等距铺开并避开 ColorPositive 的绿（#4FD08A）与 ColorNegative 的红（#F0736A），
         否则环上会有一段被读成"收入"或"亏损"。暗色底取高亮，与 ColorPositive 同亮度区间。 -->
    <SolidColorBrush x:Key="CategoryColor01" Color="#5B9BFF"/>
    <SolidColorBrush x:Key="CategoryColor02" Color="#C08BFF"/>
    <SolidColorBrush x:Key="CategoryColor03" Color="#FF85A6"/>
    <SolidColorBrush x:Key="CategoryColor04" Color="#38C9C0"/>
    <SolidColorBrush x:Key="CategoryColor05" Color="#FFB454"/>
    <SolidColorBrush x:Key="CategoryColor06" Color="#B5D95C"/>
    <SolidColorBrush x:Key="CategoryColor07" Color="#9C8CFF"/>
    <SolidColorBrush x:Key="CategoryColor08" Color="#4FC3E8"/>
    <SolidColorBrush x:Key="CategoryColor09" Color="#FF9466"/>
    <SolidColorBrush x:Key="CategoryColor10" Color="#6FD8A8"/>

    <!-- 未分类单独一色，且是有意的中性灰：它不该和任何一个具名分类撞色 -->
    <SolidColorBrush x:Key="CategoryColorOther" Color="#8C9BB0"/>
</ResourceDictionary>