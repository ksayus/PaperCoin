<Window x:Class="PaperCoin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PaperCoin.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PaperCoin" Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource ColorTextTitle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            CaptionHeight="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="5"/>
    </shell:WindowChrome.WindowChrome>
    
    <Grid Margin="6">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        </Grid.Effect>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 玻璃背板：液态玻璃那套材质是半透明的，必须有东西可透。
             本窗口是 AllowsTransparency（自绘标题栏与圆角需要它），没有系统背板，
             半透明面板会直接透到桌面 —— 浅色桌面上"暗色玻璃"暗不下来，文字对比度会垮掉。
             在透明表面下面垫一层随主题走的底色，材质的明暗就与桌面无关了。
             其它风格这个键是 Transparent，等于不存在。
             放在 Children 的第一个：Grid 按声明顺序叠放，先声明的在下层。 -->
        <Border x:Name="GlassBackdrop" Grid.RowSpan="2" CornerRadius="7"
                Background="{DynamicResource ColorGlassBackdrop}"/>

        <!--标题栏-->
        <Border Grid.Row="0" Background="{DynamicResource ColorTitleTop}"
                CornerRadius="7,7,0,0"
                BorderBrush="{DynamicResource ColorTitleTop}" BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="TitleBorder_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="PaperCoin" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource ColorTextTitle}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="Min_btn" Style="{DynamicResource MinButtonStyle}" Click="Min_btn_Click"/>
                    <Button x:Name="Max_btn" Style="{DynamicResource MaxButtonStyle}" Click="Max_btn_Click"/>
                    <Button x:Name="Close_btn" Style="{DynamicResource CloseButtonStyle}" Click="Close_btn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 侧边栏与主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--侧边栏-->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--侧边按钮-->
                <Border Grid.Row="0" Background="{DynamicResource ColorSideBar}"
                        CornerRadius="0,0,0,7"
                        BorderBrush="{DynamicResource ColorSideBar}">
                    <Grid>
                        <!-- 高亮指示器：放在最底层，不参与 StackPanel 布局 -->
                        <Border x:Name="SideBarActiveShape"
                                Width="40" Height="50"
                                CornerRadius="8"
                                Margin="4"
                                RenderTransformOrigin="0.5,0.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ColorSideBarBtnActive}"
                                Panel.ZIndex="0"
                                CacheMode="BitmapCache"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SideBarActiveShapeScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="SideBarActiveShapeTranslateTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>

                        <!-- 导航按钮：位于高亮指示器上层。图标码位集中在 Icon/AppIcons.xaml 里维护。 -->
                        <StackPanel x:Name="NavPanel" Panel.ZIndex="1">
                            <Button x:Name="TodayBillBtn" Content="&#xe682;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="TodayBill_Nav_Click" Tag="TodayBill" Visibility="Visible"/>
                            <Button x:Name="CalenderBtn" Content="&#xe71e;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="CalenderBtn_Click" Tag="CalenderBill" Visibility="Visible"/>
                            <Button x:Name="StatisticsBtn" Content="&#xe6c3;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="StatisticsBtn_Click" Tag="Statistics" Visibility="Visible"/>
                            <Button x:Name="SettingsBtn" Content="&#xe7eb;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="SettingsBtn_Click" Tag="Settings" Visibility="Visible"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--主内容区-->
            <Border Grid.Column="1" x:Name="MainContentArea"
                    CornerRadius="0,0,7,0"
                    Background="{DynamicResource ColorMainContentArea}">
                
            </Border>
        </Grid>
    </Grid>
</Window>
