<Window x:Class="PaperCoin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PaperCoin.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PaperCoin" Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource ColorTextTitle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            ResizeBorderThickness="5"
                            CaptionHeight="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="5"/>
    </shell:WindowChrome.WindowChrome>
    
    <Grid Margin="6">
        <!-- 阴影只在分层窗口下有意义：非分层窗口里 DropShadowEffect 会被窗口边界裁掉，
             只在四边留一圈脏边。走 DWM 背板时阴影由系统给。判定见 MainWindow.xaml.cs。 -->
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding UsesLayeredWindow,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="False">
                        <Setter Property="Effect" Value="{x:Null}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 玻璃背板。两种情形都靠它：
             · 有 DWM 背板（非分层窗口）时它是 Transparent，让系统给的模糊透上来 ——
               这就是"按背后画面算出来的颜色"。
             · 没有 DWM 背板时它是一层不透明底色，避免半透明面板直接透到桌面、
               浅色桌面上暗色玻璃暗不下来。
             放在 Children 的第一个：Grid 按声明顺序叠放，先声明的在下层。 -->
        <Border x:Name="GlassBackdrop" Grid.RowSpan="2"
                CornerRadius="{Binding WindowCornerRadius,
                               RelativeSource={RelativeSource AncestorType=Window}}"
                Background="{DynamicResource ColorGlassBackdrop}"/>

        <!-- 玻璃明度层：压在模糊层之上、面板之下。模糊本身不改变明度，窗口压在浅色内容上时
             模糊结果会很亮，面板上的白字会读不清；压在深色内容上又反过来。
             这一层把模糊结果的明度钉在固定一侧，对比度就不再看窗口背后是什么。
             不用 DWM 色调做这件事：DWMWA_BACKDROP_TINT_COLOR 在部分 Windows 11 版本上被拒。
             其它风格这个键是 Transparent。 -->
        <Border x:Name="GlassScrim" Grid.RowSpan="2"
                CornerRadius="{Binding WindowCornerRadius,
                               RelativeSource={RelativeSource AncestorType=Window}}"
                Background="{DynamicResource ColorGlassScrim}"/>

        <!--标题栏-->
        <Border Grid.Row="0" Background="{DynamicResource ColorTitleTop}"
                CornerRadius="7,7,0,0"
                BorderBrush="{DynamicResource ColorTitleTop}" BorderThickness="0,0,0,1"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="TitleBorder_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="PaperCoin" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource ColorTextTitle}"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="Min_btn" Style="{DynamicResource MinButtonStyle}" Click="Min_btn_Click"/>
                    <Button x:Name="Max_btn" Style="{DynamicResource MaxButtonStyle}" Click="Max_btn_Click"/>
                    <Button x:Name="Close_btn" Style="{DynamicResource CloseButtonStyle}" Click="Close_btn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 侧边栏与主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--侧边栏-->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--侧边按钮-->
                <Border Grid.Row="0" Background="{DynamicResource ColorSideBar}"
                        CornerRadius="0,0,0,7"
                        BorderBrush="{DynamicResource ColorSideBar}">
                    <Grid>
                        <!-- 高亮指示器：放在最底层，不参与 StackPanel 布局 -->
                        <Border x:Name="SideBarActiveShape"
                                Width="40" Height="50"
                                CornerRadius="8"
                                Margin="4"
                                RenderTransformOrigin="0.5,0.5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ColorSideBarBtnActive}"
                                Panel.ZIndex="0"
                                CacheMode="BitmapCache"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SideBarActiveShapeScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="SideBarActiveShapeTranslateTransform" X="0" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>

                        <!-- 导航按钮：位于高亮指示器上层。图标码位集中在 Icon/AppIcons.xaml 里维护。 -->
                        <StackPanel x:Name="NavPanel" Panel.ZIndex="1">
                            <Button x:Name="TodayBillBtn" Content="&#xe682;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="TodayBill_Nav_Click" Tag="TodayBill" Visibility="Visible"/>
                            <Button x:Name="CalenderBtn" Content="&#xe71e;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="CalenderBtn_Click" Tag="CalenderBill" Visibility="Visible"/>
                            <Button x:Name="StatisticsBtn" Content="&#xe6c3;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="StatisticsBtn_Click" Tag="Statistics" Visibility="Visible"/>
                            <Button x:Name="SettingsBtn" Content="&#xe7eb;"
                                    Style="{DynamicResource SideBarbtn}"
                                    Click="SettingsBtn_Click" Tag="Settings" Visibility="Visible"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!--主内容区-->
            <Border Grid.Column="1" x:Name="MainContentArea"
                    CornerRadius="0,0,7,0"
                    Background="{DynamicResource ColorMainContentArea}">
                
            </Border>
        </Grid>
    </Grid>
</Window>
