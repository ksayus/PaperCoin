<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTemplate x:Key="ButtonTemplateAddNewBill" TargetType="{x:Type Button}">
        <Border Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding Background}"
             SnapsToDevicePixels="True"
             CornerRadius="30">
            <ContentPresenter
             HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
             VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
             Margin="{TemplateBinding Margin}"
             RecognizesAccessKey="True"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="AddNewBill" TargetType="{x:Type Button}">
        <Setter Property="Content" Value="&#xeaf3;"/>
        <Setter Property="Background" Value="{DynamicResource ColorAddNewBillBtn}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Width" Value="50"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="FontFamily" Value="{DynamicResource Iconfont}"/>
        <Setter Property="FontSize" Value="29"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{DynamicResource ButtonTemplateAddNewBill}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorAddNewBillBtnOver}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ColorAddNewBillBtnPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>