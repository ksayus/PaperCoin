<UserControl x:Class="PaperCoin.Views.Statistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PaperCoin.Converters"
             xmlns:ctl="clr-namespace:PaperCoin.Controls"
             xmlns:views="clr-namespace:PaperCoin.Views"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:CategoryBrushConverter x:Key="CategoryBrush"/>

        <!-- 排行行。整行是按钮：点击即下钻。
             用 Button + Command 而不是自己合成鼠标事件：命令走的是与其它页面
             完全相同的绑定路径（Tag 带数据、AncestorType 取列表的 DataContext），
             键盘与无障碍也能直接到达，不必在代码后置里走可视树找行。 -->
        <Style x:Key="RankItem" TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="Transparent" Padding="0" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ColorCardActionBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类色条：卡片与图例共用，尺寸与圆角只写一处 -->
        <Style x:Key="CategorySwatch" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="0,0,7,0" ClipToBounds="True">
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 时间范围。与日历页的粒度切换同一套分段样式，RadioButton + GroupName 保证互斥。 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="本月" Style="{DynamicResource ModeRadio}"
                                 GroupName="StatsRange"
                                 IsChecked="{Binding IsMonthRange, Mode=OneWay}"
                                 Command="{Binding ShowMonthCommand}"/>
                    <RadioButton Content="本年" Style="{DynamicResource ModeRadio}"
                                 GroupName="StatsRange"
                                 IsChecked="{Binding IsYearRange, Mode=OneWay}"
                                 Command="{Binding ShowYearCommand}"/>
                    <RadioButton Content="全部" Style="{DynamicResource ModeRadio}"
                                 GroupName="StatsRange"
                                 IsChecked="{Binding IsAllRange, Mode=OneWay}"
                                 Command="{Binding ShowAllCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding RangeText}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource ColorTextSecondary}"/>
                    <Button Content="导出" Style="{DynamicResource PillButton}"
                            VerticalAlignment="Center" Margin="0,0,4,0"
                            Command="{Binding ExportCsvCommand}"/>
                    <Button Content="刷新" Style="{DynamicResource PillButton}"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 内容高于窗口时滚动。图表与排行都是固定高度，挤在小窗口里会互相压扁。 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RevealRoot" Margin="0,0,0,4">

                    <!-- 分类占比 -->
                    <TextBlock Text="分类占比" Style="{DynamicResource SettingGroupTitle}"/>

                    <Border Style="{DynamicResource SettingRow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 环 + 圆心文字。圆心文字放在环之上，不参与环的布局。 -->
                            <Grid Grid.Row="0" Height="150">
                                <ctl:DonutChart x:Name="CategoryDonut" RingThickness="26"
                                                ItemsSource="{Binding Segments}"/>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock Text="总支出" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                    <TextBlock x:Name="DonutTotal" Text="{Binding TotalExpenseText}"
                                               FontSize="19" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ColorNegative}"/>
                                    <TextBlock Text="{Binding EntryCountText}" FontSize="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 只有收入没有支出时环是空的，用一句话替代空环 -->
                            <TextBlock Grid.Row="0" Text="这个范围内没有支出"
                                       FontSize="11" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ColorTextSecondary}"
                                       Visibility="{Binding HasExpense, Converter={StaticResource BoolToVis}}"/>

                            <!-- 图例。最多 5 行（ViewModel 只给 5 行），每行"色块 名称 … 金额 占比" -->
                            <ItemsControl Grid.Row="1" Margin="0,10,0,0"
                                          ItemsSource="{Binding LegendRows}"
                                          Visibility="{Binding HasExpense,
                                                       Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{DynamicResource CategorySwatch}"
                                                    Margin="0,0,7,0"
                                                    Background="{Binding ColorKey, Converter={StaticResource CategoryBrush}}"/>

                                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource ColorTextTitle}"/>

                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}"
                                                       FontSize="11" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource ColorTextTitle}"/>

                                            <TextBlock Grid.Column="3" Text="{Binding ShareText}"
                                                       FontSize="10" Margin="8,0,0,0" MinWidth="38"
                                                       TextAlignment="Right"
                                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- 分类排行 -->
                    <Grid Margin="2,10,2,6">
                        <TextBlock Text="分类排行" Style="{DynamicResource SettingGroupTitle}"
                                   Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="查看全部" Style="{DynamicResource PillButton}"
                                    Padding="8,2" FontSize="10"
                                    Command="{Binding ShowAllCategoriesCommand}"
                                    Visibility="{Binding HasMoreRanks,
                                                 Converter={StaticResource BoolToVis}}"/>
                            <Button Content="收起" Style="{DynamicResource PillButton}"
                                    Padding="8,2" FontSize="10"
                                    Command="{Binding ShowTopCategoriesCommand}"
                                    Visibility="{Binding IsRankExpanded,
                                                 Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{DynamicResource SettingRow}">
                        <Grid>
                            <ItemsControl x:Name="RankList" Background="Transparent"
                                          ItemsSource="{Binding VisibleRankRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RankItem}"
                                                Tag="{Binding}"
                                                Command="{Binding DataContext.OpenFocusCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <!-- 条形背景铺满整行，数字压在条形之上：文字宽度随内容变，
                                                 让条形去避让文字需要额外测量，铺底更稳。 -->
                                            <Grid Height="34" Background="Transparent">
                                                <Border CornerRadius="5" Opacity="0.16"
                                                        Background="{Binding ColorKey, Converter={StaticResource CategoryBrush}}"/>

                                            <!-- 前景条：宽度由代码后置按占比算出来再动画，起点写死 0 -->
                                            <Border x:Name="RankBar" CornerRadius="5" Width="0"
                                                    HorizontalAlignment="Left"
                                                    Background="{Binding ColorKey, Converter={StaticResource CategoryBrush}}"/>

                                            <Grid Margin="9,0,9,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ColorTextTitle}"/>
                                                    <TextBlock Text="{Binding CountText}" FontSize="10"
                                                               Margin="0,1,0,0"
                                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AmountText}" FontSize="12"
                                                               HorizontalAlignment="Right"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource ColorTextTitle}"/>
                                                    <TextBlock Text="{Binding ShareText}" FontSize="10"
                                                               Margin="0,1,0,0"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                                </StackPanel>
                                            </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="这个范围内还没有支出记录" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,10,0,10"
                                       Foreground="{DynamicResource ColorTextSecondary}"
                                       Visibility="{Binding HasNoExpense, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- 月度趋势 -->
                    <Grid Margin="2,10,2,6">
                        <TextBlock Text="近 12 个月支出" Style="{DynamicResource SettingGroupTitle}"
                                   Margin="0"/>
                        <TextBlock Text="{Binding PeakMonthText}" FontSize="10"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                    </Grid>

                    <Border Style="{DynamicResource SettingRow}">
                        <!-- 柱高是**相对最高月**的比例，不是绝对金额：绝对高度会让金额小的月份
                             只剩一两个像素，在 420px 宽的窗口里读不出差别。 -->
                        <ItemsControl x:Name="TrendList" ItemsSource="{Binding TrendBars}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="110"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding AmountText}"
                                                   FontSize="8" HorizontalAlignment="Center"
                                                   Margin="0,0,0,2"
                                                   Foreground="{DynamicResource ColorTextSecondary}"/>

                                        <!-- 柱子底对齐，高度由代码后置动画到 占比 × 100 -->
                                        <Grid Grid.Row="1">
                                            <Border x:Name="TrendBar" Height="0"
                                                    Width="15" CornerRadius="3,3,0,0"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource ColorAddNewBillBtn}"
                                                    ToolTip="{Binding Tooltip}"/>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Text="{Binding Label}"
                                                   FontSize="8" HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 收支概览 -->
                    <TextBlock Text="收支概览" Style="{DynamicResource SettingGroupTitle}"
                               Margin="2,10,0,6"/>
                    <Border Style="{DynamicResource SettingRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="支出" FontSize="10"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBlock Text="{Binding TotalExpenseText}" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorNegative}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="收入" FontSize="10"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBlock Text="{Binding TotalIncomeText}" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorPositive}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                <TextBlock Text="笔数" FontSize="10"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBlock Text="{Binding EntryCountText}" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                <TextBlock Text="{Binding TopCategoryText}" FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBlock Text="{Binding AveragePerDayText}" FontSize="14"
                                           FontWeight="SemiBold" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 导出结果提示 -->
            <TextBlock Grid.Row="2" Text="{Binding Notice}"
                       FontSize="10" Margin="2,6,2,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorTextSecondary}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}"/>

            <!-- 下钻面板。与账单编辑面板同一套遮罩 + 滑入做法，开合逻辑见代码后置。 -->
            <Grid x:Name="FocusOverlay" Grid.RowSpan="3"
                  Margin="-16,-12,-16,-12"
                  Panel.ZIndex="10"
                  Background="#66000000"
                  Visibility="{Binding IsFocusOpen, Converter={StaticResource BoolToVis}}">
                <Border x:Name="FocusPanel" Width="300" MaxHeight="420"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="10"
                        Background="{DynamicResource ColorCardBackground}"
                        BorderBrush="{DynamicResource ColorCardBorder}"
                        BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="FocusScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="FocusShift" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>

                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding FocusTitle}"
                                   FontSize="14" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorTextTitle}"/>

                        <TextBlock Grid.Row="1" Text="{Binding FocusSummaryText}"
                                   FontSize="10" Margin="0,3,0,8"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>

                        <ScrollViewer Grid.Row="2" MaxHeight="280"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding FocusEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                                <TextBlock Text="{Binding DateText}" FontSize="10"
                                                           Margin="0,1,0,0"
                                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AmountText}"
                                                       FontSize="12" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ColorNegative}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="3" Content="关闭" Style="{DynamicResource PillButton}"
                                HorizontalAlignment="Right" Margin="0,10,0,0"
                                Command="{Binding CloseFocusCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
