<Window x:Class="PaperCoin.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同步冲突"
        Width="620" Height="660"
        MinWidth="560" MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Foreground="{DynamicResource ColorTextTitle}">

    <Border CornerRadius="8"
            Background="{DynamicResource ColorMainContentArea}"
            BorderBrush="{DynamicResource ColorCardBorder}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ColorTitleTop}"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="TitleBorder_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="同步冲突" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource ColorTextTitle}"/>
                    <Button Style="{DynamicResource CloseButtonStyle}"
                            HorizontalAlignment="Right" Margin="0,0,8,0"
                            Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,12,18,4">
                <TextBlock Text="{Binding PeerText}" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource ColorTextTitle}"/>
                <TextBlock Text="{Binding CountText}" FontSize="10" Margin="0,3,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorTextSecondary}"/>
                <TextBlock Text="对每一项选择保留本机或对方。取消不会应用任何更改。"
                           FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorTextSecondary}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Margin="14,4,14,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Conflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource SettingRow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <RadioButton Content="保留本机"
                                                         Style="{DynamicResource ModeRadio}"
                                                         GroupName="{Binding GroupName}"
                                                         HorizontalAlignment="Left"
                                                         IsChecked="{Binding ChooseLocal, Mode=TwoWay}"/>
                                            <TextBlock Text="{Binding LocalTitle}" FontSize="12"
                                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ColorTextTitle}"/>
                                            <TextBlock Text="{Binding LocalDetail}" FontSize="10"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="{DynamicResource ColorCardBorder}"
                                                Margin="0,2,0,2"/>

                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                            <RadioButton Content="保留对方"
                                                         Style="{DynamicResource ModeRadio}"
                                                         GroupName="{Binding GroupName}"
                                                         HorizontalAlignment="Left"
                                                         IsChecked="{Binding ChooseRemote, Mode=TwoWay}"/>
                                            <TextBlock Text="{Binding RemoteTitle}" FontSize="12"
                                                       Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ColorTextTitle}"/>
                                            <TextBlock Text="{Binding RemoteDetail}" FontSize="10"
                                                       Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="3" Padding="18,10,18,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Style="{DynamicResource PillButton}"
                            Padding="18,7"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="应用"
                            Style="{DynamicResource PillButton}"
                            Padding="18,7"
                            Margin="8,0,0,0"
                            IsEnabled="{Binding CanApply}"
                            Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
