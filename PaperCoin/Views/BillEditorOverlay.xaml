<UserControl x:Class="PaperCoin.Views.BillEditorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PaperCoin.Converters"
             Background="Transparent"
             Visibility="Collapsed">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- DataContext 是 BillEditorViewModel。宿主页面负责铺满内容区（Grid.RowSpan + 负 Margin），
         并设 Panel.ZIndex，本控件只管面板自身的开合。 -->
    <Grid x:Name="EditorLayer">

        <!-- 遮罩：点击即取消，位于面板下层。圆角必须与页面外层 Border 一致（0,0,7,0），否则右下圆角会被涂成直角。 -->
        <Border x:Name="EditorScrim" Background="#000000" Opacity="0"
                CornerRadius="0,0,7,0"
                MouseLeftButtonDown="EditorScrim_MouseLeftButtonDown"/>

        <!-- 面板外层只负责位移与阴影。阴影用下层偏移的暗色 Border，位移动画上挂 Effect 会每帧重算模糊。 -->
        <Grid x:Name="EditorPanel"
              Width="296" MaxHeight="440"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Focusable="True"
              PreviewKeyDown="EditorPanel_PreviewKeyDown">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="EditorTranslate" Y="0"/>
            </Grid.RenderTransform>

            <!-- 阴影层 -->
            <Border Margin="0,4,0,0" CornerRadius="10"
                    Background="{DynamicResource ColorShadow}"/>

            <!-- 面板实面 -->
            <Border x:Name="EditorSurface"
                    CornerRadius="10" Padding="16"
                    Background="{DynamicResource ColorMainContentArea}"
                    BorderBrush="{DynamicResource ColorCardBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding EditorTitle}"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource ColorTextTitle}"/>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">

                        <TextBlock Text="描述" FontSize="11" Margin="0,0,0,4"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBox x:Name="DescriptionBox"
                                 Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"
                                 CaretBrush="{DynamicResource ColorTextTitle}"
                                 Foreground="{DynamicResource ColorTextTitle}"
                                 Background="{DynamicResource ColorCardBackground}"
                                 BorderBrush="{DynamicResource ColorCardBorder}"
                                 BorderThickness="1"/>

                        <TextBlock Text="金额（支出填负数）" FontSize="11" Margin="0,12,0,4"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBox Text="{Binding DraftAmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"
                                 CaretBrush="{DynamicResource ColorTextTitle}"
                                 Foreground="{DynamicResource ColorTextTitle}"
                                 Background="{DynamicResource ColorCardBackground}"
                                 BorderBrush="{DynamicResource ColorCardBorder}"
                                 BorderThickness="1"/>

                        <TextBlock Text="分类（可留空）" FontSize="11" Margin="0,12,0,4"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBox Text="{Binding DraftCategory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13"
                                 CaretBrush="{DynamicResource ColorTextTitle}"
                                 Foreground="{DynamicResource ColorTextTitle}"
                                 Background="{DynamicResource ColorCardBackground}"
                                 BorderBrush="{DynamicResource ColorCardBorder}"
                                 BorderThickness="1"/>

                        <TextBlock Text="日期（可改成以前的任意一天）" FontSize="11"
                                   Margin="0,12,0,4"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <DatePicker SelectedDate="{Binding DraftDate}"
                                    Style="{DynamicResource DatePickerThemed}"/>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorNegative}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="取消" Padding="14,6" FontSize="12" Cursor="Hand"
                                Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource ColorTextSecondary}"
                                Command="{Binding CancelCommand}"/>
                        <Button Content="保存" Padding="16,6" FontSize="12" Cursor="Hand"
                                Background="{DynamicResource ColorAddNewBillBtn}"
                                BorderThickness="0"
                                Foreground="{DynamicResource ColorTextTitle}"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
