<UserControl x:Class="PaperCoin.Views.CalenderBill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PaperCoin.Converters"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:HoverSlackConverter x:Key="HoverSlack"/>
    </UserControl.Resources>

    <Border CornerRadius="0,0,7,0" ClipToBounds="True">
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 期间导航。三段式列定义（左右 Auto、标题 *）：标题最长可达 "2026 年 12 月 31 日"，用 * 吃掉剩余宽度并省略，不会与右侧按钮相撞。 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹" Style="{DynamicResource PeriodNavBtn}"
                            Command="{Binding PreviousCommand}"/>
                    <Button Content="›" Style="{DynamicResource PeriodNavBtn}"
                            Margin="4,0,0,0" Command="{Binding NextCommand}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding PeriodTitle}"
                           FontSize="14" FontWeight="Bold"
                           Margin="8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ColorTextTitle}"/>

                <Button Grid.Column="2" Content="今天"
                        Style="{DynamicResource PillButton}"
                        VerticalAlignment="Center"
                        Command="{Binding TodayCommand}"/>
            </Grid>

            <!-- 粒度切换（日 / 月 / 年） -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                <RadioButton Content="日" Style="{DynamicResource ModeRadio}"
                             IsChecked="{Binding IsDayMode, Mode=OneWay}"
                             Command="{Binding ShowDayCommand}"/>
                <RadioButton Content="月" Style="{DynamicResource ModeRadio}"
                             IsChecked="{Binding IsMonthMode, Mode=OneWay}"
                             Command="{Binding ShowMonthCommand}"/>
                <RadioButton Content="年" Style="{DynamicResource ModeRadio}"
                             IsChecked="{Binding IsYearMode, Mode=OneWay}"
                             Command="{Binding ShowYearCommand}"/>

                <TextBlock Text="{Binding TotalText}" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource ColorPositive}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource ColorNegative}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 主体。x:Name 供代码后置在聚合变化后播落定动效；Opacity 不预设为 0，否则首帧会闪一下空白，由代码后置在动画前才置 0。 -->
            <Grid x:Name="SettleTarget" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 月视图：星期表头 + 6×7 网格 -->
                <StackPanel Grid.Row="0"
                            Visibility="{Binding IsMonthMode, Converter={StaticResource BoolToVis}}">
                    <UniformGrid Columns="7" Margin="0,0,0,2">
                        <TextBlock Text="日" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBlock Text="一" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBlock Text="二" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBlock Text="三" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBlock Text="四" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBlock Text="五" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                        <TextBlock Text="六" FontSize="10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                    </UniformGrid>

                    <!-- 固定 42 格（6 周），不随月份天数变化，否则翻月时整页高度会跳动 -->
                    <ItemsControl x:Name="MonthGrid" ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="38" Margin="1" Padding="0" Cursor="Hand"
                                        Background="{DynamicResource ColorCardBackground}"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.SelectDayCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CellBorder" CornerRadius="6"
                                                    Background="{TemplateBinding Background}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="DayText" Text="{Binding Day}"
                                                               FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource ColorTextTitle}"/>
                                                    <TextBlock x:Name="AmtText" Text="{Binding TotalText}"
                                                               FontSize="8" HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!-- 非本月格压暗，仍可点击（等于跳到那一天） -->
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter TargetName="DayText" Property="Opacity" Value="0.3"/>
                                                    <Setter TargetName="AmtText" Property="Opacity" Value="0.2"/>
                                                </DataTrigger>
                                                <!-- 有记录的日子给底色 -->
                                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                                    <Setter TargetName="CellBorder" Property="Background"
                                                            Value="{DynamicResource ColorCardActionBackground}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="CellBorder" Property="BorderBrush"
                                                            Value="{DynamicResource ColorAddNewBillBtn}"/>
                                                    <Setter TargetName="CellBorder" Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CellBorder" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 年视图：12 个月 -->
                <ItemsControl x:Name="YearCards" Grid.Row="0" ItemsSource="{Binding Months}"
                              Visibility="{Binding IsYearMode, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- ScaleTransform 必须显式声明：代码后置要对它做动画，对 null 取变换会抛异常。 -->
                            <Border Margin="2" Padding="8,6" CornerRadius="6"
                                    Cursor="Hand"
                                    RenderTransformOrigin="0.5,0.5"
                                    MouseEnter="MonthCard_MouseEnter"
                                    MouseLeave="MonthCard_MouseLeave"
                                    Background="{DynamicResource ColorCardBackground}"
                                    BorderBrush="{DynamicResource ColorCardBorder}"
                                    BorderThickness="1">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="MonthScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="11"
                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                    <TextBlock Text="{Binding TotalText}" FontSize="13" FontWeight="SemiBold"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ColorTextTitle}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 明细列表：三种视图共用，内容分别是当天 / 当月 / 当年 -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- 上边距 2px：给悬浮放大的向上溢出留余量，否则首张卡片的上边框会被视口上沿裁掉。 -->
                        <ItemsControl x:Name="EntryList" ItemsSource="{Binding Entries}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 悬浮放大的左右余量，同 TodayBill：ScrollViewer 会裁掉越出视口的部分，
                                         留白按视口宽度现算，参数必须 ≥ CalenderBill.MaxHoverScale。 -->
                                    <StackPanel Margin="{Binding ActualWidth,
                                                         RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                         Converter={StaticResource HoverSlack},
                                                         ConverterParameter=1.03}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 行格子：入场上浮走这一层的 TranslateTransform，卡片面自己的 ScaleTransform 只管悬浮。
                                         行格子必须用 TranslateTransform，共用的入场动效（CardListEntrance）按这个约定找它。 -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="EntrySlotShift" X="0" Y="0"/>
                                        </Grid.RenderTransform>

                                        <!-- 悬浮浮动。变换对象必须显式声明：代码后置要对 ScaleTransform 做动画，对 null 取变换会抛异常。 -->
                                        <Border Padding="10,7" CornerRadius="6"
                                                Background="{DynamicResource ColorCardBackground}"
                                                BorderBrush="{DynamicResource ColorCardBorder}"
                                                BorderThickness="1"
                                                RenderTransformOrigin="0.5,0.5"
                                                MouseEnter="EntryCard_MouseEnter"
                                                MouseLeave="EntryCard_MouseLeave">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="EntryScale" ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource ColorTextTitle}"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="10"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding AmountText}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource ColorTextTitle}"/>
                                                    <!-- 明细带完整日期：月 / 年视图下同一列表混了多天 -->
                                                    <TextBlock Text="{Binding DateText}" FontSize="10"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空状态。变换对象在此显式声明：代码后置要动画 TranslateTransform，对 null 取变换会抛异常。 -->
                    <TextBlock x:Name="EmptyHint"
                               Text="这段时间没有记录"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" IsHitTestVisible="False"
                               Foreground="{DynamicResource ColorTextSecondary}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="EmptyHintShift" Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
