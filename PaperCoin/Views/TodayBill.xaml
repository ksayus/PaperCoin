<UserControl x:Class="PaperCoin.Views.TodayBill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PaperCoin.Converters"
             Background="Transparent">

    <!-- 不启用 x:DataType 编译期绑定：删除按钮要用 RelativeSource 取 ItemsControl 的 DataContext，编译期无法解析这类路径。 -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:HoverSlackConverter x:Key="HoverSlack"/>
    </UserControl.Resources>

    <Border CornerRadius="0,0,7,0" ClipToBounds="True">
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 汇总条。阴影用下层偏移的暗色 Border，不用 DropShadowEffect：本卡片参与缩放入场，Effect 每帧重算模糊会掉帧。 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Border Margin="0,2,0,0" CornerRadius="8"
                        Background="{DynamicResource ColorShadow}"/>
                <Border Padding="12,8" CornerRadius="8"
                        Background="{DynamicResource ColorCardBackground}"
                        BorderBrush="{DynamicResource ColorCardBorder}"
                        BorderThickness="1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="今日合计" FontSize="11"
                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                            <!-- 正负换色用样式触发器，避免再引入一个金额→Brush 的转换器 -->
                            <TextBlock x:Name="TotalTextBlock"
                                       Text="{Binding TotalText}"
                                       FontSize="19" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource ColorPositive}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource ColorNegative}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding CountText}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 流水列表 -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- 上边距 2px：给悬浮放大的向上溢出留余量，否则首张卡片的上边框会被 ScrollViewer 裁掉。
                         下边距 62px 留给右下角 + 号按钮，否则最后一条会被永久遮住。 -->
                    <ItemsControl x:Name="EntryList" ItemsSource="{Binding Entries}" Margin="0,2,0,62">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- 悬浮放大的左右余量：ScrollViewer 会裁掉越出视口的部分，留白按视口宽度现算（HoverSlackConverter），
                                     参数必须 ≥ TodayBill.MaxHoverScale。 -->
                                <StackPanel Margin="{Binding ActualWidth,
                                                     RelativeSource={RelativeSource AncestorType=ScrollViewer},
                                                     Converter={StaticResource HoverSlack},
                                                     ConverterParameter=1.02}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 行格子：入场与删除回流走这一层的 TranslateTransform，卡片面自己的 ScaleTransform 只管悬浮/按下缩放。
                                     只挂位移不挂缩放：缩放会让整列卡片每帧重新栅格化。变换必须显式声明，代码后置对 null 取变换会抛异常。 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="RowSlotShift" X="0" Y="0"/>
                                    </Grid.RenderTransform>
                                    <!-- 分层阴影：底层再放一个偏移 2px 的暗色圆角矩形，纯静态，滚动与缩放不产生额外渲染开销。 -->
                                    <Border Margin="0,2,0,0" CornerRadius="8"
                                            Background="{DynamicResource ColorShadow}"/>

                                    <!-- 卡片本体。鼠标进入/按下/点击走代码后置的动效处理，这里只把变换对象准备好并命名；
                                         RenderTransform 必须显式声明，代码里对 null 取 ScaleTransform 会抛 InvalidOperationException。 -->
                                    <Border x:Name="RowCard"
                                            Padding="12,10" CornerRadius="8"
                                            Background="{DynamicResource ColorCardBackground}"
                                            BorderBrush="{DynamicResource ColorCardBorder}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            RenderTransformOrigin="0.5,0.5"
                                            MouseEnter="RowCard_MouseEnter"
                                            MouseLeave="RowCard_MouseLeave"
                                            PreviewMouseLeftButtonDown="RowCard_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="RowCard_PreviewMouseLeftButtonUp">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="RowOffset" X="0" Y="0"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- 删除按钮独占一列：与金额同列时，右对齐的按钮会压在金额数字的右上角。 -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                                    <TextBlock Text="{Binding DateText}" FontSize="11"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource ColorTextSecondary}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding AmountText}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource ColorTextTitle}"/>

                                            <!-- 删除按钮。常态半透明表示可删，指针进入提亮；不用 Opacity=0，那样按钮仍可命中，会误删不可见的目标。
                                                 图标用矢量垃圾桶：iconfont 里没有这个字形，U+ED1B 实际是“暂停”，见 Icon/AppIcons.xaml。 -->
                                            <Button x:Name="DeleteBtn"
                                                    Grid.Column="2"
                                                    Width="20" Height="20" Padding="0"
                                                    Cursor="Hand" Opacity="0.4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="8,0,0,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    AutomationProperties.Name="删除该流水"
                                                    Command="{Binding DataContext.RemoveCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{DynamicResource IconDeleteGeometry}"
                                                      Stroke="{DynamicResource ColorTextSecondary}"
                                                      StrokeThickness="1.1"
                                                      StrokeLineJoin="Round"
                                                      SnapsToDevicePixels="True"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <Trigger SourceName="DeleteBtn" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DeleteBtn" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger SourceName="DeleteBtn" Property="IsPressed" Value="True">
                                        <Setter TargetName="DeleteBtn" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空状态。变换对象在此显式声明：代码后置要动画 TranslateTransform，对 null 取变换会抛异常。 -->
                <TextBlock x:Name="EmptyHint"
                           Text="还没有流水，点右下角 ＋ 记一笔"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12" IsHitTestVisible="False"
                           Foreground="{DynamicResource ColorTextSecondary}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="EmptyHintShift" Y="0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <!-- 记账到其他日期的提示 -->
            <TextBlock Grid.Row="2" Text="{Binding Notice}"
                       FontSize="11" Margin="0,0,0,6"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="{DynamicResource ColorTextSecondary}"
                       Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}"/>

            <!-- 右下角 + 号 -->
            <Button x:Name="AddNewBill" Grid.Row="2"
                    Style="{DynamicResource AddNewBill}"
                    RenderTransformOrigin="0.5,0.5"
                    HorizontalAlignment="Right"
                    Command="{Binding AddCommand}">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AddNewBillBtnScaleTransform" ScaleX="1" ScaleY="1"/>
                        <RotateTransform x:Name="AddNewBillBtnRotateTransform" Angle="0"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <!-- 浮动编辑面板。用 Grid.RowSpan="3" 覆盖而非单独占行，避免开合时列表重新测量导致卡片抖动。
                 负外边距抵掉父 Grid 的 Margin="16,12,16,12"，让遮罩铺满内容区；两个数是一对，改一个必须改另一个。 -->
            <Grid x:Name="EditorLayer" Grid.RowSpan="3"
                  Margin="-16,-12,-16,-12"
                  Visibility="Collapsed"
                  Panel.ZIndex="10">

                <!-- 遮罩：点击即取消，位于面板下层。圆角必须与页面外层 Border 一致（0,0,7,0），否则右下圆角会被涂成直角。 -->
                <Border x:Name="EditorScrim" Background="#000000" Opacity="0"
                        CornerRadius="0,0,7,0"
                        MouseLeftButtonDown="EditorScrim_MouseLeftButtonDown"/>

                <!-- 面板外层只负责位移与阴影。阴影同样用下层偏移的暗色 Border，位移动画上挂 Effect 会每帧重算模糊。 -->
                <Grid x:Name="EditorPanel"
                      Width="296" MaxHeight="440"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Focusable="True"
                      PreviewKeyDown="EditorPanel_PreviewKeyDown">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="EditorTranslate" Y="0"/>
                    </Grid.RenderTransform>

                    <!-- 阴影层 -->
                    <Border Margin="0,4,0,0" CornerRadius="10"
                            Background="{DynamicResource ColorShadow}"/>

                    <!-- 面板实面 -->
                    <Border x:Name="EditorSurface"
                            CornerRadius="10" Padding="16"
                            Background="{DynamicResource ColorMainContentArea}"
                            BorderBrush="{DynamicResource ColorCardBorder}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding EditorTitle}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource ColorTextTitle}"/>

                            <StackPanel Grid.Row="1" Margin="0,14,0,0">

                                <TextBlock Text="描述" FontSize="11" Margin="0,0,0,4"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBox x:Name="DescriptionBox"
                                         Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="13"
                                         CaretBrush="{DynamicResource ColorTextTitle}"
                                         Foreground="{DynamicResource ColorTextTitle}"
                                         Background="{DynamicResource ColorCardBackground}"
                                         BorderBrush="{DynamicResource ColorCardBorder}"
                                         BorderThickness="1"/>

                                <TextBlock Text="金额（支出填负数）" FontSize="11" Margin="0,12,0,4"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBox Text="{Binding DraftAmountText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="13"
                                         CaretBrush="{DynamicResource ColorTextTitle}"
                                         Foreground="{DynamicResource ColorTextTitle}"
                                         Background="{DynamicResource ColorCardBackground}"
                                         BorderBrush="{DynamicResource ColorCardBorder}"
                                         BorderThickness="1"/>

                                <TextBlock Text="分类（可留空）" FontSize="11" Margin="0,12,0,4"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <TextBox Text="{Binding DraftCategory, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6" FontSize="13"
                                         CaretBrush="{DynamicResource ColorTextTitle}"
                                         Foreground="{DynamicResource ColorTextTitle}"
                                         Background="{DynamicResource ColorCardBackground}"
                                         BorderBrush="{DynamicResource ColorCardBorder}"
                                         BorderThickness="1"/>

                                <TextBlock Text="日期（可改成以前的任意一天）" FontSize="11"
                                           Margin="0,12,0,4"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                                <DatePicker SelectedDate="{Binding DraftDate}"
                                            Style="{DynamicResource DatePickerThemed}"/>

                                <TextBlock Text="{Binding ErrorMessage}"
                                           FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ColorNegative}"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,16,0,0">
                                <Button Content="取消" Padding="14,6" FontSize="12" Cursor="Hand"
                                        Margin="0,0,8,0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource ColorTextSecondary}"
                                        Command="{Binding CancelCommand}"/>
                                <Button Content="保存" Padding="16,6" FontSize="12" Cursor="Hand"
                                        Background="{DynamicResource ColorAddNewBillBtn}"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource ColorTextTitle}"
                                        Command="{Binding SaveCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
