<UserControl x:Class="PaperCoin.Views.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PaperCoin.Converters"
             xmlns:ctl="clr-namespace:PaperCoin.Controls"
             Background="Transparent">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border CornerRadius="0,0,7,0" ClipToBounds="True">
        <!-- 内容比窗口高，必须可滚动 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,16,16">

                <!-- 外观 -->
                <TextBlock Text="外观" Style="{DynamicResource SettingGroupTitle}"/>

                <Border Style="{DynamicResource SettingRow}">
                    <!-- 主题行用上下排：内容区约 370px 宽，右侧再放三个中文分段会非常挤，分段控件独占一行。 -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource SettingRowIcon}"
                                       Text="{DynamicResource IconTheme}"
                                       FontSize="18"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="主题" FontSize="13"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                <TextBlock Text="{Binding ThemeText}"
                                           FontSize="10" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="28,10,0,0">
                            <RadioButton Content="跟随系统" Style="{DynamicResource ModeRadio}"
                                         GroupName="Theme"
                                         IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                         Command="{Binding ApplyThemeCommand}"
                                         CommandParameter="System"/>
                            <RadioButton Content="暗色" Style="{DynamicResource ModeRadio}"
                                         GroupName="Theme"
                                         IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                         Command="{Binding ApplyThemeCommand}"
                                         CommandParameter="Dark"/>
                            <RadioButton Content="亮色" Style="{DynamicResource ModeRadio}"
                                         GroupName="Theme"
                                         Margin="0"
                                         IsChecked="{Binding IsBrightTheme, Mode=OneWay}"
                                         Command="{Binding ApplyThemeCommand}"
                                         CommandParameter="Bright"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 启动与更新 -->
                <TextBlock Text="启动与更新" Style="{DynamicResource SettingGroupTitle}" Margin="2,10,0,6"/>

                <Border Style="{DynamicResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource SettingRowIcon}"
                                       Text="{DynamicResource IconPower}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="开机自动启动" FontSize="13"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                <TextBlock Text="写入当前用户的启动项，不需要管理员权限"
                                           FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <ctl:SwitchToggle Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="{Binding AutoStart, Mode=OneWay}"
                                          Command="{Binding ToggleAutoStartCommand}"/>
                    </Grid>
                </Border>

                <!-- 注册表写入失败时的提示，不弹对话框 -->
                <TextBlock Text="{Binding AutoStartError}" FontSize="10" Margin="2,-4,0,8"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ColorNegative}"
                           Visibility="{Binding HasAutoStartError, Converter={StaticResource BoolToVis}}"/>

                <Border Style="{DynamicResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource SettingRowIcon}"
                                       Text="{DynamicResource IconUpdate}"
                                       FontSize="18"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="自动更新" FontSize="13"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                <TextBlock Text="{Binding UpdateStatusText}"
                                           FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <ctl:SwitchToggle Grid.Column="1"
                                          VerticalAlignment="Center"
                                          IsOn="{Binding AutoUpdate, Mode=OneWay}"
                                          Command="{Binding ToggleAutoUpdateCommand}"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource SettingRowIcon}"
                                       Text="{DynamicResource IconDownload}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="更新源" FontSize="13"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                <TextBlock Text="决定从哪里查询新版本"
                                           FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <ComboBox Grid.Column="1" MinWidth="104"
                                  Style="{DynamicResource ComboBoxThemed}"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding UpdateSources}"
                                  SelectedItem="{Binding UpdateSource, Mode=OneWay}"/>
                    </Grid>
                </Border>

                <!-- 数据与关于 -->
                <TextBlock Text="数据与关于" Style="{DynamicResource SettingGroupTitle}" Margin="2,10,0,6"/>

                <Border Style="{DynamicResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource SettingRowIcon}"
                                       Text="{DynamicResource IconFolder}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="数据目录" FontSize="13"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                <TextBlock Text="{Binding DataFolderText}"
                                           FontSize="10" Margin="0,2,0,0"
                                           MaxWidth="170"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DataFolderText}"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1" Content="打开"
                                Style="{DynamicResource SettingButton}"
                                VerticalAlignment="Center"
                                Command="{Binding OpenDataFolderCommand}"/>
                    </Grid>
                </Border>

                <Border Style="{DynamicResource SettingRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource SettingRowIcon}"
                                       Text="{DynamicResource IconInfo}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="版本" FontSize="13"
                                           Foreground="{DynamicResource ColorTextTitle}"/>
                                <TextBlock Text="{Binding VersionText}"
                                           FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="发布页"
                                    Style="{DynamicResource SettingButton}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenReleasesCommand}"/>
                            <Button Content="恢复默认"
                                    Style="{DynamicResource SettingButton}"
                                    VerticalAlignment="Center"
                                    Command="{Binding ResetCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
