<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Icon\papercoin-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon\Iconfont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LivelyAnimationEngine\LAE\LivelyAnimationEngine.csproj" />
    <ProjectReference Include="..\PaperCoin.Core\PaperCoin.Core.csproj" />
    <ProjectReference Include="..\PaperCoin.Service\PaperCoin.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icon\Iconfont.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- 让 tools/UiSmokeTest 能访问 MainWindow 的 internal 验证入口 -->
    <InternalsVisibleTo Include="UiSmokeTest" />
  </ItemGroup>

</Project>
